generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("student")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  facultyProfile FacultyProfile?
  adminProfile   AdminProfile?
}

model StudentProfile {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  plan        String    @default("free")
  examTarget  String?
  targetYear  String?
  grade       String?
  parentPhone String?
  planEndDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  doubts       Doubt[]
  weeklyScores WeeklyScore[]
}

model FacultyProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  subject       String?
  department    String?
  qualification String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]
  doubts   Doubt[]
}

model AdminProfile {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id          Int      @id @default(autoincrement())
  title       String
  subject     String
  grade       String
  dayOfWeek   String
  scheduledAt DateTime
  duration    Int
  createdAt   DateTime @default(now())

  facultyId Int
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
}

model Doubt {
  id          Int       @id @default(autoincrement())
  question    String
  answer      String?
  answeredAt  DateTime?
  createdAt   DateTime  @default(now())

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  facultyId Int
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
}

model WeeklyScore {
  id          Int      @id @default(autoincrement())
  weekNumber  Int
  subject     String
  score       Int
  totalMarks  Int
  testDate    DateTime
  createdAt   DateTime @default(now())

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
