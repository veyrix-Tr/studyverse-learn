generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("student")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  facultyProfile FacultyProfile?
  adminProfile   AdminProfile?
}

model StudentProfile {
  id          Int       @id @default(autoincrement())
  userId      String    @unique
  plan            String    @default("spark")
  examTarget      String?
  targetYear      String?
  grade           String?
  parentPhone     String?
  planEndDate     DateTime?
  diagnosticScore   Int?
  diagnosticTakenAt DateTime?
  diagnosticAnswers Json?
  createdAt       DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  doubts               Doubt[]
  weeklyScores         WeeklyScore[]
  adminMessages        AdminMessage[]
  facultyNotifications FacultyNotification[]
  habitLogs            HabitLog[]
  completedTopics      CompletedTopic[]
  weeklyReports        WeeklyReport[]
  parentFeedback       ParentFeedback[]
}

model FacultyProfile {
  id            Int      @id @default(autoincrement())
  userId        String   @unique
  subject       String?
  department    String?
  qualification String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions             Session[]
  doubts               Doubt[]
  facultyNotifications FacultyNotification[]
  resources            Resource[]
  weeklyReports        WeeklyReport[]
}

model AdminMessage {
  id        Int       @id @default(autoincrement())
  content   String
  type      String    @default("Announcement")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  adminId   Int
  admin     AdminProfile   @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id         Int      @id @default(autoincrement())
  userId     String   @unique
  department String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminMessages     AdminMessage[]
  approvedResources Resource[]
  approvedReports   WeeklyReport[]
}

model Session {
  id          Int      @id @default(autoincrement())
  title       String
  subject     String
  grade       String
  dayOfWeek   String
  scheduledAt DateTime
  duration    Int
  note        String?
  createdAt   DateTime @default(now())

  facultyId Int
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
}

model Doubt {
  id          Int       @id @default(autoincrement())
  question    String
  subject     String?
  answer      String?
  answeredAt  DateTime?
  helpful     Boolean?
  createdAt   DateTime  @default(now())

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  facultyId Int
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
}

model WeeklyScore {
  id          Int      @id @default(autoincrement())
  weekNumber  Int
  subject     String
  score       Int
  totalMarks  Int
  testDate    DateTime
  createdAt   DateTime @default(now())

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model FacultyNotification {
  id        Int       @id @default(autoincrement())
  content   String
  type      String    @default("Session Note")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  facultyId Int
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  sessionId Int?
}

model Resource {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  subject         String
  grade           String
  type            String   // 'Study Material' | 'Previous Years' | 'Formula Sheet' | 'Session Notes'
  cloudinaryUrl   String
  cloudinaryId    String
  status          String   @default("pending") // 'pending' | 'approved' | 'declined'
  declineReason   String?
  createdAt       DateTime @default(now())
  approvedAt      DateTime?

  facultyId   Int
  faculty     FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  approvedById Int?
  approvedBy   AdminProfile? @relation(fields: [approvedById], references: [id])
}

model WeeklyReport {
  id            Int       @id @default(autoincrement())
  weekNumber    Int
  weekStartDate String    // "YYYY-MM-DD" — the Monday of the report week

  // Faculty-authored content
  overallRating Int?      // 1–5
  strengths     String?
  improvements  String?
  mentorNote    String?
  nextWeekPlan  String?

  // Snapshot from WeeklyScore at save time
  testScore      Int?
  testTotalMarks Int?
  testSubject    String?

  // Workflow
  status         String    @default("draft") // draft | submitted | approved | rejected | sent
  rejectedReason String?
  submittedAt    DateTime?
  approvedAt     DateTime?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  studentId    Int
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  facultyId    Int
  faculty      FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  approvedById Int?
  approvedBy   AdminProfile?  @relation(fields: [approvedById], references: [id])
  feedback     ParentFeedback?

  @@unique([studentId, facultyId, weekNumber])
}

model ParentFeedback {
  id        Int      @id @default(autoincrement())
  rating    Int      // 1–5
  comment   String?
  createdAt DateTime @default(now())

  reportId  Int            @unique
  report    WeeklyReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model CompletedTopic {
  id         Int      @id @default(autoincrement())
  topicName  String
  subject    String
  weekNumber Int
  createdAt  DateTime @default(now())

  studentId  Int
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, topicName, weekNumber])
  @@index([studentId])
}

model HabitLog {
  id        Int      @id @default(autoincrement())
  date      String   // YYYY-MM-DD in IST
  sleep     Boolean
  study     Boolean
  revision  Boolean
  phone     Boolean
  problems  Boolean
  createdAt DateTime @default(now())

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
