generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("student")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  facultyProfile FacultyProfile?
  adminProfile   AdminProfile?
}

model StudentProfile {
  id          Int       @id @default(autoincrement())
  userId      String    @unique
  plan            String    @default("spark")
  examTarget      String?
  targetYear      String?
  grade           String?
  city            String?
  parentPhone     String?
  planEndDate     DateTime?

  // Restore target for a superadmin manual grant that replaced an active paid
  // plan. Kept on the profile (not only in PlanGrant) so getEffectivePlan() can
  // fall back to it synchronously the moment the manual grant expires, instead
  // of waiting for the next expiry sweep to persist the restore.
  fallbackPlan    String?
  fallbackEndDate DateTime?

  diagnosticScore   Int?
  diagnosticTakenAt DateTime?
  diagnosticAnswers Json?
  createdAt       DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mentorId             Int?
  mentor               FacultyProfile?        @relation("MentorAssignment", fields: [mentorId], references: [id])
  subjectFaculty       Json?                  // { "Physics": facultyId, "Chemistry": facultyId, ... }

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  doubts               Doubt[]
  weeklyScores         WeeklyScore[]
  adminMessages        AdminMessage[]
  facultyNotifications FacultyNotification[]
  adminNotifs          AdminNotification[]
  habitLogs            HabitLog[]
  completedTopics      CompletedTopic[]
  dailyReports         DailyReport[]
  weeklyReports        WeeklyReport[]
  parentFeedback       ParentFeedback[]
  mentorNotes          MentorNote[]
  mentorCalls          MentorCall[]
  sessionRequests      SessionRequest[]
  sessions             Session[]
  sessionStudents      SessionStudent[]
  resourceRecipients   ResourceRecipient[]
  payments             Payment[]
  planGrants           PlanGrant[]
}

// Payment = a single Cashfree order. Same order is referenced by both the
// DB row and Cashfree's PG order_id. goal distinguishes a plan upgrade from
// a pay-per-session (₹99) booking, which post-payment logic branches on.
model Payment {
  id             Int       @id @default(autoincrement())
  orderId        String    @unique // Cashfree order_id (also used to look up in our DB)
  paymentId      String? // Cashfree payment_id once paid
  orderAmount    Float
  orderCurrency  String    @default("INR")
  orderStatus    String    @default("PENDING") // PENDING | PAID | FAILED | CANCELLED
  paymentStatus  String? // captured via webhook/order fetch
  paymentMethod  String?
  goal           String    // 'plan' | 'session'
  plan           String? // target plan for 'plan' payments (forge|apex|anchor)
  sessionTopic   String? // payload for 'session' payments (materialised as SessionRequest on success)
  sessionPhone   String?
  sessionTime    String?
  customerName   String?
  customerPhone  String?
  customerEmail  String?
  failureMessage String?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([orderStatus])
  @@index([studentId])
}

// PlanGrant = one row per plan assignment, whether the student paid for it or
// a superadmin granted it by hand. Pure audit ledger: the live state lives on
// StudentProfile (plan / planEndDate / fallback*), this table only records
// history so the superadmin can see who changed what and why.
model PlanGrant {
  id           Int      @id @default(autoincrement())
  plan         String   // plan that was granted
  source       String   // 'paid' | 'manual'
  durationDays Int
  startDate    DateTime
  endDate      DateTime
  reason       String? // why a superadmin granted it
  grantedBy    String? // superadmin userId (null when the student paid)
  status       String   @default("active") // active | expired | revoked | replaced
  createdAt    DateTime @default(now())
  revokedAt    DateTime?

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, endDate])
  @@index([status])
}

model FacultyProfile {
  id            Int      @id @default(autoincrement())
  userId        String   @unique
  subject       String?
  department    String?
  qualification String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions             Session[]
  doubts               Doubt[]
  facultyNotifications FacultyNotification[]
  resources            Resource[]
  weeklyReports        WeeklyReport[]
  mentorStudents       StudentProfile[]       @relation("MentorAssignment")
  mentorNotes          MentorNote[]
  mentorCalls          MentorCall[]
  facultyAlerts        FacultyAlert[]
  assignedSessions     SessionRequest[]
}

model FacultyApplication {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  subject       String
  qualification String?
  department    String?
  status        String    @default("pending") // pending | approved | rejected
  reviewedAt    DateTime?
  reviewedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AdminMessage {
  id        Int       @id @default(autoincrement())
  content   String
  type      String    @default("Announcement")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  adminId   Int
  admin     AdminProfile   @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id         Int      @id @default(autoincrement())
  userId     String   @unique
  department String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminMessages     AdminMessage[]
  approvedResources Resource[]
  approvedReports   WeeklyReport[]
  adminNotifs       AdminNotification[]
  accessLogs        AdminAccessLog[]
}

// Admin-facing assignment tasks (mentor / subject-faculty / session).
// Created when a student upgrades to Anchor/Apex or books a session; surfaced
// to admins as a persistent, highlighted inbox until the task is resolved.
model AdminNotification {
  id         Int       @id @default(autoincrement())
  content    String
  type       String    @default("mentor") // mentor | faculty | session
  status     String    @default("pending") // pending | done
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  adminId   Int
  admin     AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)
  studentId Int?
  student   StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([adminId, status])
  @@index([adminId, readAt])
}

model Session {
  id          Int      @id @default(autoincrement())
  title       String
  subject     String
  grade       String
  dayOfWeek   String
  scheduledAt DateTime
  duration    Int
  note        String?
  createdAt   DateTime @default(now())

  zoomMeetingId String?
  joinUrl       String?
  startUrl      String?
  zoomPassword  String?

  facultyId Int
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  studentId Int? // legacy primary student for old 1:1 sessions. Prefer `students` for real enrollments.
  student   StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  students SessionStudent[]
}

model SessionStudent {
  id        Int            @id @default(autoincrement())
  sessionId Int
  studentId Int
  session   Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([sessionId])
}

model Doubt {
  id          Int       @id @default(autoincrement())
  question    String
  subject     String?
  answer      String?
  answeredAt  DateTime?
  helpful     Boolean?
  createdAt   DateTime  @default(now())

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  facultyId Int
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
}

model WeeklyScore {
  id          Int      @id @default(autoincrement())
  weekNumber  Int
  subject     String
  score       Int
  totalMarks  Int
  testDate    DateTime
  createdAt   DateTime @default(now())

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model FacultyNotification {
  id        Int       @id @default(autoincrement())
  content   String
  type      String    @default("Session Note")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  facultyId Int
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  sessionId Int?
}

model Resource {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  subject         String
  grade           String
  type            String   // 'Study Material' | 'Previous Years' | 'Formula Sheet' | 'Session Notes'
  cloudinaryUrl   String
  cloudinaryId    String
  status          String   @default("pending") // 'pending' | 'approved' | 'declined'
  declineReason   String?
  createdAt       DateTime @default(now())
  approvedAt      DateTime?

  facultyId   Int
  faculty     FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  approvedById Int?
  approvedBy   AdminProfile? @relation(fields: [approvedById], references: [id])
  recipients  ResourceRecipient[]
}

model ResourceRecipient {
  id         Int      @id @default(autoincrement())
  resourceId Int
  studentId  Int
  createdAt  DateTime @default(now())

  resource Resource        @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  student  StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([resourceId, studentId])
  @@index([studentId])
  @@index([resourceId])
}

model WeeklyReport {
  id            Int       @id @default(autoincrement())
  weekNumber    Int
  weekStartDate String    // "YYYY-MM-DD" — the Monday of the report week

  // Faculty-authored content
  overallRating Int?      // 1–5
  strengths     String?
  improvements  String?
  mentorNote    String?
  nextWeekPlan  String?

  // Snapshot from WeeklyScore at save time
  testScore      Int?
  testTotalMarks Int?
  testSubject    String?

  // Workflow
  status         String    @default("draft") // draft | submitted | approved | rejected | sent
  rejectedReason String?
  submittedAt    DateTime?
  approvedAt     DateTime?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  studentId    Int
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  facultyId    Int
  faculty      FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  approvedById Int?
  approvedBy   AdminProfile?  @relation(fields: [approvedById], references: [id])
  feedback     ParentFeedback?

  @@unique([studentId, facultyId, weekNumber])
}

model ParentFeedback {
  id        Int      @id @default(autoincrement())
  rating    Int      // 1–5
  comment   String?
  createdAt DateTime @default(now())

  reportId  Int            @unique
  report    WeeklyReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model CompletedTopic {
  id         Int      @id @default(autoincrement())
  topicName  String
  subject    String
  weekNumber Int
  createdAt  DateTime @default(now())

  studentId  Int
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, topicName, weekNumber])
  @@index([studentId])
}

model DailyReport {
  id              Int      @id @default(autoincrement())
  date            String   // YYYY-MM-DD IST
  mood            String   // '1'–'5'
  showedUp        String   // 'Yes' | 'No'
  hrsPhysics      Float?
  hrsChemistry    Float?
  hrsThird        Float?   // Biology or Maths depending on exam
  focusQuality    Int      // 1–5
  topicsDone      String?
  questionsSolved Int?
  mockToday       String?  // 'Yes' | 'No'
  mockScore       String?
  wentWell        String?
  wentHard        String?
  tomorrowOne     String?
  noteForMentor   String?
  createdAt       DateTime @default(now())

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

model HabitLog {
  id        Int      @id @default(autoincrement())
  date      String   // YYYY-MM-DD in IST
  sleep     Boolean
  study     Boolean
  revision  Boolean
  phone     Boolean
  problems  Boolean
  createdAt DateTime @default(now())

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

model MentorNote {
  id        Int      @id @default(autoincrement())
  content   String
  weekOf    String   // YYYY-MM-DD (Monday of the week)
  createdAt DateTime @default(now())

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentorId  Int
  mentor    FacultyProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model MentorCall {
  id          Int      @id @default(autoincrement())
  scheduledAt DateTime
  durationMin Int      @default(45)
  meetLink    String?
  notes       String?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  zoomMeetingId String?
  joinUrl       String?
  startUrl      String?
  zoomPassword  String?

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentorId  Int
  mentor    FacultyProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model FacultyAlert {
  id        Int       @id @default(autoincrement())
  content   String
  type      String    // 'Doubt', 'Call Reminder', 'Admin', 'Resource', 'Report', 'Mentor Report'
  readAt    DateTime?
  createdAt DateTime  @default(now())

  facultyId Int
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SessionRequest {
  id            Int       @id @default(autoincrement())
  topic         String
  phone         String?
  preferredTime String?
  status        String    @default("pending") // pending | assigned | done | cancelled
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentId     Int
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Populated when admin assigns
  facultyId     Int?
  faculty       FacultyProfile? @relation(fields: [facultyId], references: [id])
  scheduledAt   DateTime?
  durationMin   Int?
  adminNote     String?
  assignedAt    DateTime?

  @@index([studentId])
  @@index([status])
}

// Real audit trail of admin activity, surfaced on the dashboard's
// "Super Admin Access Log". Every meaningful admin action is logged here
// with who did it (acting admin) and when.
model AdminAccessLog {
  id        Int      @id @default(autoincrement())
  action    String   // e.g. resource.approve | resource.decline | mentor.assign | faculty.assign | message.send | admin.create | admin.deactivate | admin.reactivate
  target    String?  // human description of what was acted on (e.g. resource title, student name)
  metadata  Json?
  createdAt DateTime @default(now())

  adminId  Int? // acting admin (null for system/cron driven actions)
  admin    AdminProfile? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([createdAt])
}
